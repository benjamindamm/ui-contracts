<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="SelectWithSearch" initial="machine">
<datamodel><data id="options" expr="[]"/><data id="value" expr="undefined"/><data id="query" expr="''"/><data id="activeKey" expr="undefined"/><data id="enabled" expr="true"/><data id="required" expr="false"/><data id="matches" expr="function(o,q){return (o.label+' '+o.key).toLowerCase().indexOf(q.toLowerCase())!==-1;}"/></datamodel>
<state id="machine" initial="closed">
<transition event="SET_OPTIONS" cond="_event.data &amp;&amp; Array.isArray(_event.data.options) &amp;&amp; _event.data.options.every(function(o,i,a){return o &amp;&amp; typeof o.key==='string' &amp;&amp; o.key.trim().length&gt;0 &amp;&amp; typeof o.label==='string' &amp;&amp; o.label.trim().length&gt;0 &amp;&amp; (o.disabled===undefined || typeof o.disabled==='boolean') &amp;&amp; a.every(function(p,j){return i===j || p.key!==o.key;});})"><assign location="options" expr="_event.data.options.slice()"/><assign location="activeKey" expr="undefined"/><if cond="value!==undefined &amp;&amp; !options.some(function(o){return o.key===value &amp;&amp; !o.disabled;})"><assign location="value" expr="undefined"/><send event="value-change" target="#_parent"><param name="value" expr="value"/><param name="reason" expr="'options-change'"/></send></if></transition>
<transition event="SET_VALUE" cond="_event.data &amp;&amp; (_event.data.value===undefined || options.some(function(o){return o.key===_event.data.value &amp;&amp; !o.disabled;}))"><assign location="value" expr="_event.data.value"/></transition>
<transition event="SET_REQUIRED" cond="_event.data &amp;&amp; typeof _event.data.required==='boolean'"><assign location="required" expr="_event.data.required"/></transition>
<transition event="SET_ENABLED" cond="_event.data &amp;&amp; _event.data.enabled===false" target="disabled"><assign location="enabled" expr="false"/><assign location="query" expr="''"/><assign location="activeKey" expr="undefined"/></transition>
<transition event="SET_ENABLED" cond="_event.data &amp;&amp; _event.data.enabled===true" target="closed"><assign location="enabled" expr="true"/></transition>
<state id="closed"><transition event="OPEN" target="opened"/></state>
<state id="opened"><onentry><assign location="query" expr="''"/><assign location="activeKey" expr="undefined"/></onentry><onexit><assign location="query" expr="''"/><assign location="activeKey" expr="undefined"/></onexit>
<transition event="SEARCH" cond="_event.data &amp;&amp; typeof _event.data.query==='string'"><assign location="query" expr="_event.data.query"/><assign location="activeKey" expr="undefined"/></transition>
<transition event="ACTIVE_KEY" cond="_event.data &amp;&amp; options.some(function(o){return o.key===_event.data.key &amp;&amp; !o.disabled &amp;&amp; matches(o,query);})"><assign location="activeKey" expr="_event.data.key"/></transition>
<transition event="USER_SELECT" cond="_event.data &amp;&amp; options.some(function(o){return o.key===_event.data.value &amp;&amp; !o.disabled &amp;&amp; matches(o,query);})" target="closed"><if cond="value!==_event.data.value"><assign location="value" expr="_event.data.value"/><send event="value-change" target="#_parent"><param name="value" expr="value"/><param name="reason" expr="'user'"/></send></if></transition>
<transition event="CLOSE ESCAPE" target="closed"/>
</state><state id="disabled"/>
</state></scxml>