<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" id="acux01" name="Autocomplete UX candidate 0.1" namespace="urn:ui-contracts:research:ac-ux-01">
<decision id="creationClassification" name="creationClassification"><literalExpression id="creationClassificationExpr"><text>if requiresNewEntries = null then "unknown" else if requiresNewEntries instance of boolean then (if requiresNewEntries then "incompatible" else "compatible") else "invalid-input"</text></literalExpression></decision>
<decision id="creation" name="creation"><informationRequirement id="creationReq"><requiredDecision href="#creationClassification"/></informationRequirement><decisionTable id="creationTable" hitPolicy="UNIQUE"><input id="creationInput"><inputExpression id="creationInputExpr" typeRef="string"><text>creationClassification</text></inputExpression></input><output id="creationOutput" name="outcome" typeRef="string"/>
<rule id="AC-UX-001_compatible"><inputEntry id="AC-UX-001_compatibleIn"><text>"compatible"</text></inputEntry><outputEntry id="AC-UX-001_compatibleOut"><text>"compatible"</text></outputEntry></rule>
<rule id="AC-UX-001_incompatible"><inputEntry id="AC-UX-001_incompatibleIn"><text>"incompatible"</text></inputEntry><outputEntry id="AC-UX-001_incompatibleOut"><text>"incompatible"</text></outputEntry></rule>
<rule id="AC-UX-001_unknown"><inputEntry id="AC-UX-001_unknownIn"><text>"unknown"</text></inputEntry><outputEntry id="AC-UX-001_unknownOut"><text>"unknown"</text></outputEntry></rule>
<rule id="AC-UX-001_invalid_input"><inputEntry id="AC-UX-001_invalid_inputIn"><text>"invalid-input"</text></inputEntry><outputEntry id="AC-UX-001_invalid_inputOut"><text>"invalid-input"</text></outputEntry></rule>
</decisionTable></decision>
<decision id="cardinalityClassification" name="cardinalityClassification"><literalExpression id="cardinalityClassificationExpr"><text>if requiredCardinality = null then "unknown" else if requiredCardinality instance of string then (if requiredCardinality = "one" then "compatible" else if requiredCardinality = "many" then "incompatible" else "invalid-input") else "invalid-input"</text></literalExpression></decision>
<decision id="cardinality" name="cardinality"><informationRequirement id="cardinalityReq"><requiredDecision href="#cardinalityClassification"/></informationRequirement><decisionTable id="cardinalityTable" hitPolicy="UNIQUE"><input id="cardinalityInput"><inputExpression id="cardinalityInputExpr" typeRef="string"><text>cardinalityClassification</text></inputExpression></input><output id="cardinalityOutput" name="outcome" typeRef="string"/>
<rule id="AC-UX-002_compatible"><inputEntry id="AC-UX-002_compatibleIn"><text>"compatible"</text></inputEntry><outputEntry id="AC-UX-002_compatibleOut"><text>"compatible"</text></outputEntry></rule>
<rule id="AC-UX-002_incompatible"><inputEntry id="AC-UX-002_incompatibleIn"><text>"incompatible"</text></inputEntry><outputEntry id="AC-UX-002_incompatibleOut"><text>"incompatible"</text></outputEntry></rule>
<rule id="AC-UX-002_unknown"><inputEntry id="AC-UX-002_unknownIn"><text>"unknown"</text></inputEntry><outputEntry id="AC-UX-002_unknownOut"><text>"unknown"</text></outputEntry></rule>
<rule id="AC-UX-002_invalid_input"><inputEntry id="AC-UX-002_invalid_inputIn"><text>"invalid-input"</text></inputEntry><outputEntry id="AC-UX-002_invalid_inputOut"><text>"invalid-input"</text></outputEntry></rule>
</decisionTable></decision>
<decision id="labelsClassification" name="labelsClassification"><literalExpression id="labelsClassificationExpr"><text>if resultLabelsFamiliar = null then "unknown" else if resultLabelsFamiliar instance of boolean then (if resultLabelsFamiliar then "satisfied" else if labelExceptionApproved then "excepted" else "needs-review") else "invalid-input"</text></literalExpression></decision>
<decision id="labels" name="labels"><informationRequirement id="labelsReq"><requiredDecision href="#labelsClassification"/></informationRequirement><decisionTable id="labelsTable" hitPolicy="UNIQUE"><input id="labelsInput"><inputExpression id="labelsInputExpr" typeRef="string"><text>labelsClassification</text></inputExpression></input><output id="labelsOutput" name="outcome" typeRef="string"/>
<rule id="AC-UX-003_satisfied"><inputEntry id="AC-UX-003_satisfiedIn"><text>"satisfied"</text></inputEntry><outputEntry id="AC-UX-003_satisfiedOut"><text>"satisfied"</text></outputEntry></rule>
<rule id="AC-UX-003_needs_review"><inputEntry id="AC-UX-003_needs_reviewIn"><text>"needs-review"</text></inputEntry><outputEntry id="AC-UX-003_needs_reviewOut"><text>"needs-review"</text></outputEntry></rule>
<rule id="AC-UX-003_excepted"><inputEntry id="AC-UX-003_exceptedIn"><text>"excepted"</text></inputEntry><outputEntry id="AC-UX-003_exceptedOut"><text>"excepted"</text></outputEntry></rule>
<rule id="AC-UX-003_unknown"><inputEntry id="AC-UX-003_unknownIn"><text>"unknown"</text></inputEntry><outputEntry id="AC-UX-003_unknownOut"><text>"unknown"</text></outputEntry></rule>
<rule id="AC-UX-003_invalid_input"><inputEntry id="AC-UX-003_invalid_inputIn"><text>"invalid-input"</text></inputEntry><outputEntry id="AC-UX-003_invalid_inputOut"><text>"invalid-input"</text></outputEntry></rule>
</decisionTable></decision>
<decision id="assessment" name="assessment"><informationRequirement id="assess-creation"><requiredDecision href="#creation"/></informationRequirement><informationRequirement id="assess-cardinality"><requiredDecision href="#cardinality"/></informationRequirement><informationRequirement id="assess-labels"><requiredDecision href="#labels"/></informationRequirement><literalExpression id="assessmentExpr"><text>{creation: creation, cardinality: cardinality, labels: labels, overall: if creation = "invalid-input" or cardinality = "invalid-input" or labels = "invalid-input" then "invalid-input" else if creation = "incompatible" or cardinality = "incompatible" then "incompatible" else if creation = "unknown" or cardinality = "unknown" then "undetermined" else if labels = "unknown" then "compatible-guidance-unknown" else if labels = "needs-review" then "compatible-with-guidance" else "compatible"}</text></literalExpression></decision></definitions>
