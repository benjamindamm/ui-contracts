  "rules": [
    {
      "id": "AC-UX-001",
      "decisionId": "creation",
      "strength": "capability-constraint",
      "status": "candidate",
      "purpose": "Exclude tasks requiring this control to confirm newly created values.",
      "rationale": "The existing definition commits a key from available results; free text is not a newly committed result.",
      "evidence": [
        "capability-text",
        "interface",
        "behavior"
      ],
      "exceptionsAllowed": false
    },
    {
      "id": "AC-UX-002",
      "decisionId": "cardinality",
      "strength": "capability-constraint",
      "status": "candidate",
      "purpose": "Exclude tasks requiring simultaneous multiple committed selections.",
      "rationale": "The bound interface describes one string-valued committed key, not a collection.",
      "evidence": [
        "interface"
      ],
      "exceptionsAllowed": false
    },
    {
      "id": "AC-UX-003",
      "decisionId": "labels",
      "strength": "recommendation",
      "status": "candidate",
      "purpose": "Prefer result labels familiar to the intended users.",
      "rationale": "Typing and recognizing results depends on meaningful audience-specific labels; nonempty strings alone do not prove familiarity.",
      "evidence": [
        "USWDS-familiar-labels",
        "accessibility"
      ],
      "exceptionsAllowed": true
    }
  ],
