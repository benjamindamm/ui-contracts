<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" id="ux03" name="UX experiment" namespace="urn:ux-rules-03"><decision id="conflict" name="conflict"><decisionTable id="tbl" hitPolicy="COLLECT"><input id="flag"><inputExpression id="input" typeRef="boolean"><text>flag</text></inputExpression></input><output id="out" name="outcome" typeRef="string"/><rule id="recommend"><inputEntry id="irecommend"><text>true</text></inputEntry><outputEntry id="orecommend"><text>"recommend"</text></outputEntry></rule><rule id="exclude"><inputEntry id="iexclude"><text>true</text></inputEntry><outputEntry id="oexclude"><text>"exclude"</text></outputEntry></rule></decisionTable></decision></definitions>