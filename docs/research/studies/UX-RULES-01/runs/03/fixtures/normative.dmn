<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" id="ux03" name="UX experiment" namespace="urn:ux-rules-03"><decision id="sharedRequirement" name="sharedRequirement"><literalExpression id="sharedExpr"><text>if mandatoryMet then "met" else "unmet"</text></literalExpression></decision><decision id="normative" name="normative"><variable id="v" name="normative"/><informationRequirement id="needs-shared"><requiredDecision href="#sharedRequirement"/></informationRequirement><literalExpression id="expr"><text>{applicable: library = "example" and componentId = "ui-contracts:Autocomplete", permitted: if applicable then mandatoryMet else null, requirement: if not(applicable) then "not-applicable" else sharedRequirement, recommendation: if not(applicable) then "not-applicable" else if preferenceMet then "met" else if exceptionApproved and exceptionComponent = componentId then "excepted" else "unmet"}</text></literalExpression></decision></definitions>