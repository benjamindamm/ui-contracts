@prefix ex: <urn:uxprobe:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:Eligibility a sh:NodeShape ; sh:targetNode ex:context ;
 sh:property [ sh:path ex:existingEntriesOnly ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue true ] ;
 sh:property [ sh:path ex:singleSelection ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue true ] .
