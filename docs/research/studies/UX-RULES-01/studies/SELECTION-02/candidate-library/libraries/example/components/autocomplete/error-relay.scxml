<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="ResearchErrorRelay" datamodel="ecmascript" initial="reporting"><datamodel><data id="owner" expr="'unset'"/><data id="epoch" expr="0"/><data id="fault" expr="'unknown'"/></datamodel><state id="reporting"><onentry><send event="init.failed" target="#_parent"><param name="owner" expr="owner"/><param name="epoch" expr="epoch"/><param name="fault" expr="fault"/></send></onentry></state></scxml>
