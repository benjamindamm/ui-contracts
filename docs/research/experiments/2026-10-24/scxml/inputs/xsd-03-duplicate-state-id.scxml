<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="closed"><datamodel><data id="count" expr="0"/></datamodel><state id="closed"><transition event="OPEN" cond="_event.data.allowed === true" target="open"><assign location="count" expr="count + _event.data.delta"/></transition></state><state id="closed"><transition event="CLOSE" target="closed"/></state></scxml>
