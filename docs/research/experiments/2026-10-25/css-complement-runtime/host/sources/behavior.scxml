<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="ResearchCombobox" datamodel="ecmascript" initial="ready"><datamodel><data id="enabled" expr="true"/><data id="query" expr="''"/><data id="value" expr="''"/></datamodel><state id="ready" initial="closed"><transition event="SET_ENABLED"><assign location="enabled" expr="_event.data.enabled"/></transition><transition event="QUERY"><assign location="query" expr="_event.data.query"/></transition><state id="closed"><transition event="OPEN" cond="enabled" target="open"><assign location="query" expr="_event.data.query"/></transition></state><state id="open"><transition event="CLOSE" target="closed"/><transition event="COMMIT" target="selected"><assign location="value" expr="_event.data.value"/></transition></state><state id="selected"><onentry><send event="value-change" target="#_parent"><param name="value" expr="value"/><param name="query" expr="query"/></send></onentry><transition target="closed"/></state></state></scxml>
