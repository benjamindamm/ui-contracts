{
  "$schema": "https://raw.githubusercontent.com/johnlindquist/uxspec/20dfae0e7224d952e198afdf4ffed26d6fd67180/schema/uxspec.schema.json",
  "$description": "Own isolated generated research projection or consumer; not a selected product contract",
  "$machine": {
    "id": "timer-consumer",
    "initial": "active",
    "states": {
      "active": {
        "$visual": {
          "autoDismiss": "{clock:missing}"
        },
        "on": {
          "AUTO_DISMISS": "done"
        }
      },
      "done": {}
    }
  },
  "$imports": {
    "clock": {
      "from": "./projection.json",
      "tokens": true
    }
  },
  "$events": {
    "AUTO_DISMISS": {
      "source": "timer"
    }
  }
}
