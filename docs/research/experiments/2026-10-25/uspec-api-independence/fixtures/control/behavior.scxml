<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="Autocomplete" datamodel="ecmascript" initial="closed"><datamodel><data id="value" expr="'alpha'"/></datamodel><state id="closed"><transition event="OPEN" target="open"/></state><state id="open"><transition event="CLOSE" target="closed"/><transition event="COMMIT" target="selected"/></state><state id="selected"><onentry><send event="value-change" target="#_parent"><param name="value" expr="value"/></send></onentry><transition target="closed"/></state></scxml>
