{
  "interface": "{\n  \"schemaVersion\": \"2.1.0\",\n  \"modules\": [\n    {\n      \"kind\": \"javascript-module\",\n      \"path\": \"autocomplete.js\",\n      \"declarations\": [\n        {\n          \"kind\": \"class\",\n          \"customElement\": true,\n          \"name\": \"Autocomplete\",\n          \"members\": [\n            {\n              \"kind\": \"field\",\n              \"name\": \"value\",\n              \"type\": {\n                \"text\": \"string\"\n              }\n            }\n          ],\n          \"events\": [\n            {\n              \"name\": \"value-change\",\n              \"type\": {\n                \"text\": \"CustomEvent<{value:string}>\"\n              }\n            }\n          ],\n          \"cssParts\": [\n            {\n              \"name\": \"input\"\n            },\n            {\n              \"name\": \"popup\"\n            },\n            {\n              \"name\": \"list\"\n            },\n            {\n              \"name\": \"option\"\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}\n",
  "behavior": "<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" name=\"Autocomplete\" datamodel=\"ecmascript\" initial=\"closed\"><datamodel><data id=\"value\" expr=\"'alpha'\"/></datamodel><state id=\"closed\"><transition event=\"OPEN\" target=\"open\"/></state><state id=\"open\"><transition event=\"CLOSE\" target=\"closed\"/><transition event=\"COMMIT\" target=\"selected\"/></state><state id=\"selected\"><onentry><send event=\"value-change\" target=\"#_parent\"><param name=\"value\" expr=\"value\"/></send></onentry><transition target=\"closed\"/></state></scxml>\n",
  "visual": "section { margin-bottom:260px; }\n[role=\"option\"] { height:32px; box-sizing:border-box; }\n#input-a {anchor-name:--input-a;}\n#popup-a {position:absolute;position-anchor:--input-a;top:anchor(bottom);left:anchor(left);margin-top:8px;max-height:160px;overflow-y:auto;}\n#input-b {anchor-name:--input-b;}\n#popup-b {position:absolute;position-anchor:--input-b;top:anchor(bottom);left:anchor(left);margin-top:8px;max-height:160px;overflow-y:auto;}\n",
  "accessibility": "<main><section><label for=\"input-a\">Suche A</label><input id=\"input-a\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"true\" aria-controls=\"list-a\" aria-activedescendant=\"option-a-0\"><div id=\"popup-a\"><div id=\"list-a\" role=\"listbox\" aria-label=\"Ergebnisse A\"><div id=\"option-a-0\" role=\"option\" aria-selected=\"true\">Ergebnis A 1</div><div id=\"option-a-1\" role=\"option\" aria-selected=\"false\">Ergebnis A 2</div><div id=\"option-a-2\" role=\"option\" aria-selected=\"false\">Ergebnis A 3</div><div id=\"option-a-3\" role=\"option\" aria-selected=\"false\">Ergebnis A 4</div><div id=\"option-a-4\" role=\"option\" aria-selected=\"false\">Ergebnis A 5</div><div id=\"option-a-5\" role=\"option\" aria-selected=\"false\">Ergebnis A 6</div><div id=\"option-a-6\" role=\"option\" aria-selected=\"false\">Ergebnis A 7</div></div></div></section><section><label for=\"input-b\">Suche B</label><input id=\"input-b\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"true\" aria-controls=\"list-b\" aria-activedescendant=\"option-b-0\"><div id=\"popup-b\"><div id=\"list-b\" role=\"listbox\" aria-label=\"Ergebnisse B\"><div id=\"option-b-0\" role=\"option\" aria-selected=\"true\">Ergebnis B 1</div><div id=\"option-b-1\" role=\"option\" aria-selected=\"false\">Ergebnis B 2</div><div id=\"option-b-2\" role=\"option\" aria-selected=\"false\">Ergebnis B 3</div><div id=\"option-b-3\" role=\"option\" aria-selected=\"false\">Ergebnis B 4</div><div id=\"option-b-4\" role=\"option\" aria-selected=\"false\">Ergebnis B 5</div><div id=\"option-b-5\" role=\"option\" aria-selected=\"false\">Ergebnis B 6</div><div id=\"option-b-6\" role=\"option\" aria-selected=\"false\">Ergebnis B 7</div></div></div></section></main>\n"
}
