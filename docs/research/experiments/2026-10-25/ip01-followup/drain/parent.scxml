<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="ResearchRoot" datamodel="ecmascript" initial="closed">
<datamodel><data id="owner" expr="'unset'"/><data id="epoch" expr="0"/><data id="ready" expr="0"/><data id="reports" expr="0"/><data id="rejected" expr="0"/><data id="lastOffset" expr="-1"/><data id="errors" expr="0"/></datamodel>
<state id="closed"><transition event="OPEN" target="open"><assign location="epoch" expr="epoch+1"/></transition></state>
<state id="open"><invoke id="overlay" type="scxml" src="overlay.scxml"><param name="owner" expr="owner"/><param name="epoch" expr="epoch"/></invoke>
<transition event="CLOSE" target="closed"/>
<transition event="overlay.ready" cond="_event.data.owner===owner &amp;&amp; _event.data.epoch===epoch"><assign location="ready" expr="ready+1"/></transition>
<transition event="overlay.report" cond="_event.data.owner===owner &amp;&amp; _event.data.epoch===epoch"><assign location="reports" expr="reports+1"/><assign location="lastOffset" expr="_event.data.offset"/></transition>
<transition event="overlay.ready overlay.report"><assign location="rejected" expr="rejected+1"/></transition>
<transition event="SCROLL"><send event="SCROLL" target="#_overlay"><param name="offset" expr="_event.data.offset"/></send></transition>
<transition event="init.failed" target="closed"><assign location="errors" expr="errors+1"/></transition>
</state></scxml>
