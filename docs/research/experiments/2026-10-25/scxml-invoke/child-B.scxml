<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="ResearchScrollArea" datamodel="ecmascript" initial="active"><datamodel><data id="owner" expr="'unknown'"/><data id="offset" expr="0"/></datamodel><state id="active"><onentry><send event="child.ready" target="#_parent"><param name="owner" expr="owner"/><param name="offset" expr="offset"/></send></onentry><transition event="SCROLL"><assign location="offset" expr="_event.data.offset"/><send event="child.report" target="#_parent"><param name="owner" expr="owner"/><param name="offset" expr="offset"/></send></transition></state></scxml>
