<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="ResearchAutocompleteHost" datamodel="ecmascript" initial="closed"><datamodel><data id="instance" expr="'unset'"/></datamodel><state id="closed"><transition event="OPEN" target="open"/></state><state id="open"><invoke id="scroll" type="scxml" src="child.scxml"><param name="owner" expr="instance"/></invoke><transition event="CLOSE" target="closed"/><transition event="SCROLL"><send event="SCROLL" target="#_scroll"><param name="offset" expr="_event.data.offset"/></send></transition></state></scxml>
