<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" id="choicePolicy" name="Fixed-value choice study policy" namespace="urn:ui-contracts:selection-study">
<decision id="searchNeed" name="searchNeed"><literalExpression id="searchNeedExpr"><text>if searchExplicitlyRequired != null then (if searchExplicitlyRequired instance of boolean then (if searchExplicitlyRequired then "required" else "not-required") else "invalid-input") else if optionCount = null or searchRequiredAbove = null then "unknown" else if optionCount instance of number and searchRequiredAbove instance of number then (if optionCount &lt; 0 or floor(optionCount) != optionCount or searchRequiredAbove &lt; 0 or floor(searchRequiredAbove) != searchRequiredAbove then "invalid-input" else if optionCount &gt; searchRequiredAbove then "required" else "not-required") else "invalid-input"</text></literalExpression></decision>
<decision id="selectFit" name="selectFit"><informationRequirement id="selectFit-searchNeed"><requiredDecision href="#searchNeed"/></informationRequirement><literalExpression id="selectFitExpr"><text>if searchNeed = "invalid-input" then "invalid-input" else if selectCapabilities.role != "choice" or selectCapabilities.selectionCardinality != "one" then "incompatible-role" else if fixedValuesRequired and selectCapabilities.valueDomain != "listed-keys" then "incompatible-value-domain" else if not(queryEditingAllowed) and selectCapabilities.valueDisplayEditable then "incompatible-editing" else if searchNeed = "unknown" then "undetermined" else if searchNeed = "required" and selectCapabilities.searchMode = "none" then "incompatible-search" else if searchNeed = "required" and selectCapabilities.searchMode = "query-provider" and not(filteringProviderAvailable) then "missing-filter-provider" else "eligible"</text></literalExpression></decision>
<decision id="autocompleteFit" name="autocompleteFit"><informationRequirement id="autocompleteFit-searchNeed"><requiredDecision href="#searchNeed"/></informationRequirement><literalExpression id="autocompleteFitExpr"><text>if searchNeed = "invalid-input" then "invalid-input" else if autocompleteCapabilities.role != "choice" or autocompleteCapabilities.selectionCardinality != "one" then "incompatible-role" else if fixedValuesRequired and autocompleteCapabilities.valueDomain != "listed-keys" then "incompatible-value-domain" else if not(queryEditingAllowed) and autocompleteCapabilities.valueDisplayEditable then "incompatible-editing" else if searchNeed = "unknown" then "undetermined" else if searchNeed = "required" and autocompleteCapabilities.searchMode = "none" then "incompatible-search" else if searchNeed = "required" and autocompleteCapabilities.searchMode = "query-provider" and not(filteringProviderAvailable) then "missing-filter-provider" else "eligible"</text></literalExpression></decision>
<decision id="choice" name="choice"><informationRequirement id="choice-searchNeed"><requiredDecision href="#searchNeed"/></informationRequirement><informationRequirement id="choice-selectFit"><requiredDecision href="#selectFit"/></informationRequirement><informationRequirement id="choice-autocompleteFit"><requiredDecision href="#autocompleteFit"/></informationRequirement><literalExpression id="choiceExpr"><text>{searchNeed: searchNeed, Select: selectFit, Autocomplete: autocompleteFit, choice: if selectFit = "invalid-input" or autocompleteFit = "invalid-input" then "invalid-input" else if selectFit = "eligible" and autocompleteFit = "eligible" then (if completionAssistancePreferred then "Autocomplete" else "Select") else if selectFit = "eligible" then "Select" else if autocompleteFit = "eligible" then "Autocomplete" else if selectFit = "undetermined" or autocompleteFit = "undetermined" then "needs-clarification" else "no-defined-candidate", reason: if selectFit = "eligible" and autocompleteFit = "eligible" then (if completionAssistancePreferred then "project-preference-for-selection-completion" else "project-preference-for-simple-fixed-choice") else if autocompleteFit = "eligible" then "required-search-with-fixed-commit" else if selectFit = "eligible" then "fixed-choice-without-editable-value-display" else "resolve-constraints-or-add-searchable-select-variant"}</text></literalExpression></decision>
</definitions>
