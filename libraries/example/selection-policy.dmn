<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" id="choicePolicy" name="Fixed-value choice study policy" namespace="urn:ui-contracts:selection-study">
<decision id="searchNeed" name="searchNeed"><literalExpression id="searchNeedExpr"><text>if searchExplicitlyRequired != null then (if searchExplicitlyRequired instance of boolean then (if searchExplicitlyRequired then "required" else "not-required") else "invalid-input") else if optionCount = null or searchRequiredAbove = null then "unknown" else if optionCount instance of number and searchRequiredAbove instance of number then (if optionCount &lt; 0 or floor(optionCount) != optionCount or searchRequiredAbove &lt; 0 or floor(searchRequiredAbove) != searchRequiredAbove then "invalid-input" else if optionCount &gt; searchRequiredAbove then "required" else "not-required") else "invalid-input"</text></literalExpression></decision>
<decision id="selectFit" name="selectFit"><informationRequirement id="selectFit-searchNeed"><requiredDecision href="#searchNeed"/></informationRequirement><literalExpression id="selectFitExpr"><text>if selectVerification != "verified-limited" then "unverified-capabilities" else if searchNeed = "invalid-input" then "invalid-input" else if selectCapabilities.role != "choice" or selectCapabilities.selectionCardinality != "one" then "incompatible-role" else if fixedValuesRequired and selectCapabilities.valueDomain != "listed-keys" then "incompatible-value-domain" else if not(selectedLabelEditingAllowed) and selectCapabilities.valueDisplayEditable then "incompatible-editing" else if searchNeed = "required" and not(queryEditingAllowed) then "incompatible-search-input" else if searchNeed = "unknown" then "undetermined" else if searchNeed = "required" and selectCapabilities.searchMode = "none" then "incompatible-search" else if searchNeed = "required" and selectCapabilities.searchMode = "query-provider" and not(filteringProviderAvailable) then "missing-filter-provider" else "eligible"</text></literalExpression></decision>
<decision id="autocompleteFit" name="autocompleteFit"><informationRequirement id="autocompleteFit-searchNeed"><requiredDecision href="#searchNeed"/></informationRequirement><literalExpression id="autocompleteFitExpr"><text>if autocompleteVerification != "verified-limited" then "unverified-capabilities" else if searchNeed = "invalid-input" then "invalid-input" else if autocompleteCapabilities.role != "choice" or autocompleteCapabilities.selectionCardinality != "one" then "incompatible-role" else if fixedValuesRequired and autocompleteCapabilities.valueDomain != "listed-keys" then "incompatible-value-domain" else if not(selectedLabelEditingAllowed) and autocompleteCapabilities.valueDisplayEditable then "incompatible-editing" else if searchNeed = "required" and not(queryEditingAllowed) then "incompatible-search-input" else if searchNeed = "unknown" then "undetermined" else if searchNeed = "required" and autocompleteCapabilities.searchMode = "none" then "incompatible-search" else if searchNeed = "required" and autocompleteCapabilities.searchMode = "query-provider" and not(filteringProviderAvailable) then "missing-filter-provider" else "eligible"</text></literalExpression></decision>
<decision id="searchSelectFit" name="searchSelectFit"><informationRequirement id="searchSelectFit-searchNeed"><requiredDecision href="#searchNeed"/></informationRequirement><literalExpression id="searchSelectFitExpr"><text>if searchSelectVerification != "verified-limited" then "unverified-capabilities" else if searchNeed = "invalid-input" then "invalid-input" else if searchSelectCapabilities.role != "choice" or searchSelectCapabilities.selectionCardinality != "one" then "incompatible-role" else if fixedValuesRequired and searchSelectCapabilities.valueDomain != "listed-keys" then "incompatible-value-domain" else if not(selectedLabelEditingAllowed) and searchSelectCapabilities.valueDisplayEditable then "incompatible-editing" else if searchNeed = "required" and not(queryEditingAllowed) then "incompatible-search-input" else if searchNeed = "unknown" then "undetermined" else if searchNeed = "required" and searchSelectCapabilities.searchMode = "none" then "incompatible-search" else if searchNeed = "required" and searchSelectCapabilities.searchMode = "query-provider" and not(filteringProviderAvailable) then "missing-filter-provider" else "eligible"</text></literalExpression></decision>
<decision id="choice" name="choice"><informationRequirement id="choice-searchNeed"><requiredDecision href="#searchNeed"/></informationRequirement><informationRequirement id="choice-selectFit"><requiredDecision href="#selectFit"/></informationRequirement><informationRequirement id="choice-autocompleteFit"><requiredDecision href="#autocompleteFit"/></informationRequirement><informationRequirement id="choice-searchSelectFit"><requiredDecision href="#searchSelectFit"/></informationRequirement><literalExpression id="choiceExpr"><text>{searchNeed: searchNeed, Select: selectFit, SelectWithSearch: searchSelectFit, Autocomplete: autocompleteFit, choice: if selectFit = "invalid-input" then "invalid-input" else if selectFit = "eligible" then "Select" else if searchSelectFit = "eligible" then "SelectWithSearch" else if autocompleteFit = "eligible" then "Autocomplete" else if selectFit = "undetermined" or searchSelectFit = "undetermined" then "needs-clarification" else if selectFit = "unverified-capabilities" or searchSelectFit = "unverified-capabilities" or autocompleteFit = "unverified-capabilities" then "needs-verification" else "no-defined-candidate", reason: if selectFit = "eligible" then "simple-fixed-choice" else if searchSelectFit = "eligible" then "fixed-choice-with-separate-search-preferred-over-completion" else if autocompleteFit = "eligible" then "listed-key-completion-fallback-needs-explicit-justification" else "resolve-constraints-or-missing-definition"}</text></literalExpression></decision></definitions>