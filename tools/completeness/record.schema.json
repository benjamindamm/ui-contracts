{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Contracts authoring coverage record 1 (own workflow convention)",
  "type": "object",
  "required": [
    "format",
    "componentId",
    "componentSha256",
    "profile",
    "requirements",
    "profileSha256"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ui-contracts-completeness/1"
    },
    "componentId": {
      "type": "string",
      "minLength": 1
    },
    "componentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "open",
              "mapped",
              "conflict"
            ]
          },
          "note": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sha256",
                "selector"
              ],
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "selector": {
                  "type": "object",
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "json-pointer",
                        "xpath",
                        "lines"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
