<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="ResearchScrollArea" initial="active"><datamodel><data id="owner" expr="'unset'"/><data id="epoch" expr="0"/></datamodel><state id="active"><onentry><send event="scroll.ready" target="#_parent"><param name="owner" expr="owner"/><param name="epoch" expr="epoch"/></send></onentry><transition event="REVEAL"/><transition event="MEASURED"><send event="scroll.revealed" target="#_parent"><param name="owner" expr="owner"/><param name="epoch" expr="epoch"/><param name="key" expr="_event.data.key"/><param name="requestId" expr="_event.data.requestId"/><param name="visible" expr="_event.data.visible"/><param name="offset" expr="_event.data.offset"/></send></transition></state></scxml>
