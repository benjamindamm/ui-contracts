{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Contracts minimal library index 1 (own convention)",
  "type": "object",
  "required": [
    "kind",
    "components"
  ],
  "properties": {
    "kind": {
      "const": "ui-contract-library-draft"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "policy",
        "capabilitiesSchema"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "capabilitiesSchema": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
