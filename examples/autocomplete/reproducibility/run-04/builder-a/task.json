  "acceptance": [
    {
      "id": "cases",
      "required": true,
      "description": "autocomplete.fig enthaelt genau zehn Faell-frames mit den Quellnamen closed, opening, loading, ready, active, scroll-end, selected, empty, error und disabled; jeder Fall ist eine benannte, editierbare Layergruppe (COMPONENT oder FRAME)."
    },
    {
      "id": "parts",
      "required": true,
      "description": "Innerhalb jedes Falls bleiben Input, Overlayflaeche, Scrollviewport, Listbox, einzelne Optionen und Status als getrennt editierbare, verstaendlich benannte Layer erhalten."
    },
    {
      "id": "fidelity",
      "required": true,
      "description": "Farben, Typografie, Maasse und Meldungen folgen den gepinnten Quellen (tokens.json, layout.css-Dateien, accessibility.rules.json, stories.json); Abweichungen und Definitionsluecken sind in REPORT.md dokumentiert, nicht versteckt."
    },
    {
      "id": "scrollend",
      "required": true,
      "description": "Der Fall scroll-end zeigt die aktive letzte Option im sichtbaren Viewport (Inhalt entsprechend versetzt); alle sieben Ergebnislayer bleiben editierbar erhalten."
    },
    {
      "id": "readback",
      "required": true,
      "description": "autocomplete.fig oeffnet sich als OpenPencil-Dokument und wurde mit der gepinnten Toolchain zurueckgelesen; das Readback-Receipt (JSON) liegt im Ausgabeordner."
    },
    {
      "id": "handoff",
      "required": true,
      "description": "handoff-v1.json liegt im Ausgabeordner und fuehrt Receipts, Artefakte, klassifizierte Claims und Checks zu allen Abnahmekriterien nach dem Uebergabevertrag; ready nur mit Bestandsnachweisen und ohne blockierende Fragen."
    }
  ],
  "context": {
    "maxBootstrapChars": 2000,
    "maxInlineChars": 8000,
    "maxHandoffChars": 16000
  }
}
